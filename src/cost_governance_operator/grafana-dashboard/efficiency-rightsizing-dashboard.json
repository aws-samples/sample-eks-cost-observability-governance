    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "CPU and memory efficiency per namespace with wasted resources",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "CPU Util %" }, "properties": [
            { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "gauge" } },
            { "id": "max", "value": 100 }, { "id": "min", "value": 0 },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "red", "value": null }, { "color": "orange", "value": 20 },
              { "color": "yellow", "value": 40 }, { "color": "green", "value": 60 }
            ]}}
          ]},
          { "matcher": { "id": "byName", "options": "Mem Util %" }, "properties": [
            { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "gauge" } },
            { "id": "max", "value": 100 }, { "id": "min", "value": 0 },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "red", "value": null }, { "color": "orange", "value": 20 },
              { "color": "yellow", "value": 40 }, { "color": "green", "value": 60 }
            ]}}
          ]},
          { "matcher": { "id": "byName", "options": "Wasted CPU" }, "properties": [{ "id": "unit", "value": "short" }, { "id": "decimals", "value": 2 }] },
          { "matcher": { "id": "byName", "options": "Wasted Mem" }, "properties": [{ "id": "unit", "value": "bytes" }] }
        ]
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 10 },
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "CPU Util %" }]
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "100 * sum by (namespace) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate) / sum by (namespace) (kube_pod_container_resource_requests{resource=\"cpu\"})", "format": "table", "instant": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "100 * sum by (namespace) (node_namespace_pod_container:container_memory_working_set_bytes) / sum by (namespace) (kube_pod_container_resource_requests{resource=\"memory\"})", "format": "table", "instant": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (namespace) (kube_pod_container_resource_requests{resource=\"cpu\"}) - sum by (namespace) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate)", "format": "table", "instant": true, "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (namespace) (kube_pod_container_resource_requests{resource=\"memory\"}) - sum by (namespace) (node_namespace_pod_container:container_memory_working_set_bytes)", "format": "table", "instant": true, "refId": "D" }
      ],
      "title": "Namespace Efficiency",
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "namespace" } },
        { "id": "organize", "options": {
          "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true },
          "renameByName": { "namespace": "Namespace", "Value #A": "CPU Util %", "Value #B": "Mem Util %", "Value #C": "Wasted CPU", "Value #D": "Wasted Mem" }
